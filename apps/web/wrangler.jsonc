{
  // The dashboard. It reaches the gateway only through this service binding, and has no binding to D1, Durable Objects or the Rust API.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "podster-web",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": "dist/client",
    "html_handling": "none",
    "not_found_handling": "none",
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_next/static/*", "!/*/_next/static/*"]
  },
  "services": [{ "binding": "GATEWAY", "service": "podster-gateway" }],
  // Local run only. Password sign-in also needs ENABLE_PASSWORD_SIGNIN on the gateway, which refuses it on a real hostname.
  "vars": { "APP_URL": "http://app.localhost:3000", "SIGN_IN_PROVIDERS": "", "LOCAL_PASSWORD_SIGNIN": "true" },
  "env": {
    // Nothing here exists yet. docs/adr/0001 lists what staging needs, and the route waits on that decision.
    "staging": {
      "workers_dev": false,
      "preview_urls": false,
      "services": [{ "binding": "GATEWAY", "service": "podster-gateway-staging" }],
      "vars": { "APP_URL": "https://app-staging.podster.dev", "SIGN_IN_PROVIDERS": "github", "LOCAL_PASSWORD_SIGNIN": "false" }
    }
  }
}
