{
  // Private API: reached only by service binding, with no public route or workers.dev URL.
  "name": "podster-api",
  "main": "build/index.js",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "WORKSPACE", "class_name": "Workspace" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Workspace"] }]
  // ASSERTION_KEYS is a secret: a JSON object of kid to base64url Ed25519 public key.
}
